{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PreferenceProfile",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "profile_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "study_mode": {
      "type": "string",
      "enum": [
        "quiet",
        "discussion",
        "any"
      ]
    },
    "quiet_priority": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "low_occupancy_priority": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "brightness_priority": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "comfort_priority": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "distance_priority": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "preferred_temperature_c": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 10,
      "maximum": 35
    }
  },
  "required": [
    "schema_version",
    "profile_id",
    "study_mode",
    "quiet_priority",
    "low_occupancy_priority",
    "brightness_priority",
    "comfort_priority",
    "distance_priority"
  ]
}
