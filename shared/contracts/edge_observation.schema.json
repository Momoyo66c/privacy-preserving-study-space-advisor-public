{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EdgeObservation",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "observation_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "room_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "device_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "observed_at": {
      "type": "string",
      "format": "date-time"
    },
    "window_seconds": {
      "type": "integer",
      "minimum": 5,
      "maximum": 10
    },
    "room_state": {
      "type": "string",
      "enum": [
        "empty_or_low_activity",
        "quiet_study_recommended",
        "discussion_allowed",
        "not_recommended_noisy_or_crowded",
        "unknown"
      ]
    },
    "occupancy_level": {
      "type": "string",
      "enum": [
        "empty",
        "low",
        "medium",
        "high",
        "unknown"
      ]
    },
    "suitability_score": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "features": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "thermal_hot_region_count": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "radar_active_target_count": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "sound_rms_mean": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "sound_peak_max": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "light_relative_mean": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "light_lux": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "temperature_c": {
          "type": [
            "number",
            "null"
          ],
          "minimum": -50,
          "maximum": 100
        },
        "humidity_pct": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 100
        }
      }
    },
    "sensor_health": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "thermal": {
          "type": "string",
          "enum": [
            "ok",
            "degraded",
            "offline",
            "not_configured"
          ]
        },
        "radar": {
          "type": "string",
          "enum": [
            "ok",
            "degraded",
            "offline",
            "not_configured"
          ]
        },
        "sound": {
          "type": "string",
          "enum": [
            "ok",
            "degraded",
            "offline",
            "not_configured"
          ]
        },
        "environment": {
          "type": "string",
          "enum": [
            "ok",
            "degraded",
            "offline",
            "not_configured"
          ]
        }
      },
      "required": [
        "thermal",
        "radar",
        "sound",
        "environment"
      ]
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "feature_schema_version": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "name",
        "version",
        "feature_schema_version"
      ]
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 256
      },
      "maxItems": 32
    }
  },
  "required": [
    "schema_version",
    "observation_id",
    "room_id",
    "device_id",
    "observed_at",
    "window_seconds",
    "room_state",
    "occupancy_level",
    "suitability_score",
    "confidence",
    "features",
    "sensor_health",
    "model",
    "warnings"
  ]
}
