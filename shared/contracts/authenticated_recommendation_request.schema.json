{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AuthenticatedRecommendationRequest",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {"type": "string", "const": "1.0"},
    "study_mode": {
      "type": "string",
      "enum": ["quiet", "discussion", "any"]
    },
    "candidate_room_ids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
      }
    }
  },
  "required": ["schema_version", "study_mode", "candidate_room_ids"]
}
