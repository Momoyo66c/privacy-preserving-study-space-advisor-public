{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "StudyAdvisorResponse",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "preferences": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "quiet_priority": {"type": "number", "minimum": 0, "maximum": 1},
        "low_occupancy_priority": {"type": "number", "minimum": 0, "maximum": 1},
        "brightness_priority": {"type": "number", "minimum": 0, "maximum": 1},
        "comfort_priority": {"type": "number", "minimum": 0, "maximum": 1},
        "distance_priority": {"type": "number", "minimum": 0, "maximum": 1}
      },
      "required": [
        "quiet_priority",
        "low_occupancy_priority",
        "brightness_priority",
        "comfort_priority",
        "distance_priority"
      ]
    },
    "recommendation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "room_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "rank": {"type": "integer", "minimum": 1},
        "score": {"type": "integer", "minimum": 0, "maximum": 100},
        "current_state": {
          "type": "string",
          "enum": [
            "empty_or_low_activity",
            "quiet_study_recommended",
            "discussion_allowed",
            "not_recommended_noisy_or_crowded",
            "unknown"
          ]
        },
        "occupancy_level": {
          "type": "string",
          "enum": ["empty", "low", "medium", "high", "unknown"]
        },
        "forecast_30m": {
          "type": "string",
          "enum": ["empty", "low", "medium", "high", "unknown"]
        },
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "is_stale": {"type": "boolean"},
        "reasons": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "items": {"type": "string"}
        },
        "explanation": {"type": "string"},
        "explanation_source": {
          "type": "string",
          "enum": ["stub", "template", "llm"]
        }
      },
      "required": [
        "room_id",
        "rank",
        "score",
        "current_state",
        "occupancy_level",
        "forecast_30m",
        "confidence",
        "is_stale",
        "reasons",
        "explanation",
        "explanation_source"
      ]
    }
  },
  "properties": {
    "schema_version": {"type": "string", "const": "1.0"},
    "request_id": {"type": "string"},
    "generated_at": {"type": "string", "format": "date-time"},
    "interpreted_study_mode": {
      "type": "string",
      "enum": ["quiet", "discussion", "any"]
    },
    "interpreted_needs": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "quiet",
          "discussion",
          "low_occupancy",
          "bright",
          "comfortable",
          "saved_preferences"
        ]
      }
    },
    "applied_preferences": {"$ref": "#/$defs/preferences"},
    "focus_room_id": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        {"type": "null"}
      ]
    },
    "advisor_message": {"type": "string"},
    "advice_source": {
      "type": "string",
      "enum": ["stub", "template", "llm"]
    },
    "recommendations": {
      "type": "array",
      "items": {"$ref": "#/$defs/recommendation"}
    },
    "warnings": {
      "type": "array",
      "items": {"type": "string"}
    }
  },
  "required": [
    "schema_version",
    "request_id",
    "generated_at",
    "interpreted_study_mode",
    "interpreted_needs",
    "applied_preferences",
    "focus_room_id",
    "advisor_message",
    "advice_source",
    "recommendations",
    "warnings"
  ]
}
