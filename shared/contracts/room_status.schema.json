{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RoomStatus",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "room_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "name": {
      "type": "string"
    },
    "location": {
      "type": [
        "string",
        "null"
      ]
    },
    "observed_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "received_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "room_state": {
      "type": "string",
      "enum": [
        "empty_or_low_activity",
        "quiet_study_recommended",
        "discussion_allowed",
        "not_recommended_noisy_or_crowded",
        "unknown"
      ]
    },
    "occupancy_level": {
      "type": "string",
      "enum": [
        "empty",
        "low",
        "medium",
        "high",
        "unknown"
      ]
    },
    "suitability_score": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0,
      "maximum": 100
    },
    "confidence": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 1
    },
    "features": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "thermal_hot_region_count": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "radar_active_target_count": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "sound_rms_mean": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "light_lux": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "temperature_c": {
          "type": [
            "number",
            "null"
          ],
          "minimum": -50,
          "maximum": 100
        },
        "humidity_pct": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 100
        }
      }
    },
    "sensor_health": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "thermal": {
          "type": "string",
          "enum": [
            "ok",
            "degraded",
            "offline",
            "not_configured"
          ]
        },
        "radar": {
          "type": "string",
          "enum": [
            "ok",
            "degraded",
            "offline",
            "not_configured"
          ]
        },
        "sound": {
          "type": "string",
          "enum": [
            "ok",
            "degraded",
            "offline",
            "not_configured"
          ]
        },
        "environment": {
          "type": "string",
          "enum": [
            "ok",
            "degraded",
            "offline",
            "not_configured"
          ]
        }
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "data_age_seconds": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "is_stale": {
      "type": "boolean"
    },
    "forecasts": {
      "type": "array",
      "items": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "title": "ForecastResult",
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "schema_version": {
            "type": "string",
            "const": "1.0"
          },
          "room_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
          },
          "generated_at": {
            "type": "string",
            "format": "date-time"
          },
          "target_at": {
            "type": "string",
            "format": "date-time"
          },
          "horizon_minutes": {
            "type": "integer",
            "enum": [
              15,
              30
            ]
          },
          "predicted_occupancy_level": {
            "type": "string",
            "enum": [
              "empty",
              "low",
              "medium",
              "high",
              "unknown"
            ]
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "method": {
            "type": "string"
          },
          "model_version": {
            "type": "string"
          },
          "input_start_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "input_end_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "fallback_reason": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "schema_version",
          "room_id",
          "generated_at",
          "target_at",
          "horizon_minutes",
          "predicted_occupancy_level",
          "confidence",
          "method",
          "model_version",
          "input_start_at",
          "input_end_at",
          "fallback_reason"
        ]
      }
    }
  },
  "required": [
    "schema_version",
    "room_id",
    "name",
    "room_state",
    "occupancy_level",
    "features",
    "sensor_health",
    "warnings",
    "is_stale",
    "forecasts"
  ]
}
