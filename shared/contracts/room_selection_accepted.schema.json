{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RoomSelectionAccepted",
  "$defs": {
    "preference": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "study_mode": {"type": "string", "enum": ["quiet", "discussion", "any"]},
        "quiet_priority": {"type": "number", "minimum": 0, "maximum": 1},
        "low_occupancy_priority": {"type": "number", "minimum": 0, "maximum": 1},
        "brightness_priority": {"type": "number", "minimum": 0, "maximum": 1},
        "comfort_priority": {"type": "number", "minimum": 0, "maximum": 1},
        "distance_priority": {"type": "number", "minimum": 0, "maximum": 1},
        "preferred_temperature_c": {"type": ["number", "null"], "minimum": 10, "maximum": 35}
      },
      "required": [
        "study_mode",
        "quiet_priority",
        "low_occupancy_priority",
        "brightness_priority",
        "comfort_priority",
        "distance_priority",
        "preferred_temperature_c"
      ]
    }
  },
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {"type": "string", "const": "1.0"},
    "accepted": {"type": "boolean", "const": true},
    "selection_id": {"type": "string", "format": "uuid"},
    "room_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "recorded_at": {"type": "string", "format": "date-time"},
    "effective_preferences": {"$ref": "#/$defs/preference"}
  },
  "required": [
    "schema_version",
    "accepted",
    "selection_id",
    "room_id",
    "recorded_at",
    "effective_preferences"
  ]
}
