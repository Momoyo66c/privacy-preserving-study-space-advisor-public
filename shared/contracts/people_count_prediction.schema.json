{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PeopleCountPrediction",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "people_count_prediction.v1"
    },
    "prediction_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "window_id": {
      "type": ["string", "null"],
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "room_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "device_id": {
      "type": ["string", "null"],
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "observed_at": {
      "type": "string",
      "format": "date-time"
    },
    "predicted_people_count": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "predicted_people_count_rounded": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    },
    "occupancy_level": {
      "type": "string",
      "enum": ["empty", "low", "medium", "high", "unknown"]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "feature_schema_version": {"type": "string", "minLength": 1}
      },
      "required": ["name", "version", "feature_schema_version"]
    },
    "warnings": {
      "type": "array",
      "items": {"type": "string", "maxLength": 256},
      "maxItems": 32
    },
    "features": {
      "type": ["object", "null"],
      "additionalProperties": {
        "type": "number"
      }
    }
  },
  "required": [
    "schema_version",
    "prediction_id",
    "room_id",
    "observed_at",
    "predicted_people_count",
    "predicted_people_count_rounded",
    "occupancy_level",
    "confidence",
    "model",
    "warnings"
  ]
}
