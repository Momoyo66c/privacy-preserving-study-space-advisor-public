{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ForecastResult",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "room_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "target_at": {
      "type": "string",
      "format": "date-time"
    },
    "horizon_minutes": {
      "type": "integer",
      "enum": [
        15,
        30
      ]
    },
    "predicted_occupancy_level": {
      "type": "string",
      "enum": [
        "empty",
        "low",
        "medium",
        "high",
        "unknown"
      ]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "method": {
      "type": "string"
    },
    "model_version": {
      "type": "string"
    },
    "input_start_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "input_end_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "fallback_reason": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "schema_version",
    "room_id",
    "generated_at",
    "target_at",
    "horizon_minutes",
    "predicted_occupancy_level",
    "confidence",
    "method",
    "model_version",
    "input_start_at",
    "input_end_at",
    "fallback_reason"
  ]
}
