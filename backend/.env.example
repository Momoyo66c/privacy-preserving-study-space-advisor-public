APP_ENV=development
DATABASE_URL=sqlite:///./study_space.db
STALE_AFTER_SECONDS=30
EXPECTED_OBSERVATION_INTERVAL_SECONDS=5
MAX_REQUEST_BODY_BYTES=131072
MAX_HISTORY_HOURS=168
MAX_HISTORY_POINTS=2000
FUTURE_SKEW_SECONDS=300
DELAYED_OBSERVATION_WARNING_SECONDS=86400
MAX_OBSERVATION_AGE_DAYS=30
OBSERVATION_RETENTION_DAYS=30
FORECAST_RETENTION_DAYS=30
RECOMMENDATION_RETENTION_DAYS=7
AUTO_REGISTER_DEVICES=true
EDGE_API_TOKEN=
CORS_ORIGINS=["http://localhost:5173"]
RECOMMENDATION_ADAPTER_TIMEOUT_SECONDS=2
ALLOW_ANONYMOUS_DEMO=true
SESSION_TTL_SECONDS=28800
SESSION_COOKIE_SECURE=false
LOGIN_MAX_FAILURES=5
LOGIN_FAILURE_WINDOW_SECONDS=900
SELECTION_RETENTION_DAYS=90
