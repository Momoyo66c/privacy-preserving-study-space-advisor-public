# Copy this file to ~/.config/pssa/dashboard-bridge.env on the Raspberry Pi.
# Replace the documentation-only address with the backend computer's trusted-LAN IP.
PSSA_BACKEND_URL=http://192.0.2.10:8000

# Choose one production input profile. The Windows microphone profile keeps
# ESP32 thermal/light/climate collection and replaces only the failed HW-485.
PSSA_SENSOR_CONFIG=config/esp32-hub.example.yaml
# PSSA_SENSOR_CONFIG=config/esp32-hub-windows-mic.example.yaml

# Required only by esp32-hub-windows-mic.example.yaml. Generate a unique
# 32-byte random token and put the same value in the Windows process environment.
# Never commit the real token.
# PSSA_REMOTE_SOUND_TOKEN=

# Enable the device-specific 0..1 HW-486 profile after two-point capture.
# This is a relative calibration and never produces lux.
# HW486_RELATIVE_CALIBRATION_PATH=/home/pi/.config/pssa/calibration/hw486-relative.json

# Enable a tested device-specific HW-485 0..1 profile. It is not dB.
# HW485_RELATIVE_CALIBRATION_PATH=/home/pi/.config/pssa/calibration/hw485-relative-trial.json

# Set EDGE_API_TOKEN only when the backend enables edge write authentication.
# Never commit the real token.
# EDGE_API_TOKEN=
